
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Perkins Restaurant &amp; Bakery — Franchise Opportunity</title>
<meta name="description" content="Sixty years in. Just getting good. Own a Perkins Restaurant & Bakery franchise — a comfort-food brand America has trusted since 1958, built for modern growth." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<!-- Brand-sanctioned web fonts: Roboto Condensed (body + headline Bold) and Lobster (script accent). Print headlines use Futura PT Cond Bold; the brand book specifies Roboto Condensed Bold as the web substitute. -->
<link href="https://fonts.googleapis.com/css2?family=Lobster&family=Roboto+Condensed:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
<style>
/* ============================================================
   PERKINS RESTAURANT & BAKERY — DESIGN SYSTEM
   Tokens sourced from Perkins_Brand Guidelines_2026
   ============================================================ */
:root{
  --green:#384E46;          /* Perkins Green (primary)   */
  --green-deep:#2A3B35;
  --cream:#EDECE6;          /* Perkins Cream (primary)   */
  --marigold:#E69025;       /* Yellow  (accent, large/decorative only) */
  --sage:#839566;           /* Light Green (decorative)  */
  --sage-ada:#8DAA68;       /* ADA large-format light green */
  --salmon:#CF5B5A;         /* Salmon  (decorative)      */
  --ink:#2A3B35;
  --paper:#F6F5F0;

  --display:"Roboto Condensed",system-ui,-apple-system,sans-serif; /* used at 700, all caps */
  --script:"Lobster",cursive;
  --body:"Roboto Condensed",system-ui,sans-serif;

  --pad:clamp(1.25rem,5vw,6rem);
  --maxw:1200px;
  --r:14px;
  --ease:cubic-bezier(.22,1,.36,1);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--body);background:var(--paper);color:var(--ink);line-height:1.55;font-weight:400;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
h1,h2,h3,h4{font-family:var(--display);font-weight:700;line-height:1;letter-spacing:.005em;text-transform:uppercase}
.script{font-family:var(--script);text-transform:none;font-weight:400;letter-spacing:0}
section{position:relative}

/* ---------- Brand bars (two-weight, per brand book: thin bar = 43% of thick) ---------- */
.brandbars{padding:1rem var(--pad);background:var(--cream);display:flex;flex-direction:column;gap:6px}
.brandbars .b{border-radius:99px}
.brandbars .b1{height:13px;background:linear-gradient(90deg,var(--green) 0 27%,var(--sage) 27% 50%,var(--marigold) 50% 75%,var(--salmon) 75% 100%)}
.brandbars .b2{height:6px;width:62%;background:linear-gradient(90deg,var(--marigold) 0 33%,var(--salmon) 33% 62%,var(--green) 62% 100%)}
.brandbars.on-dark{background:var(--green-deep)}

/* ---------- Buttons ---------- */
.btn{display:inline-flex;align-items:center;gap:.55rem;font-family:var(--display);text-transform:uppercase;font-weight:700;letter-spacing:.05em;font-size:1.02rem;padding:.95rem 1.9rem;border-radius:999px;border:2px solid transparent;cursor:pointer;transition:transform .35s var(--ease),background .3s,color .3s,box-shadow .3s}
.btn:hover{transform:translateY(-3px)}
.btn-amber{background:var(--marigold);color:var(--green-deep);box-shadow:0 10px 30px -10px rgba(230,144,37,.55)}
.btn-amber:hover{background:#f29c30}
.btn-green{background:var(--green);color:var(--cream)}
.btn-green:hover{background:var(--green-deep)}
.btn-ghost{background:transparent;border-color:currentColor}
.btn-ghost:hover{background:rgba(237,236,230,.12)}
.btn .arrow{transition:transform .35s var(--ease)}
.btn:hover .arrow{transform:translateX(4px)}

/* ---------- Nav (cream, so the preferred green logo reads; green↔cream = AAA) ---------- */
header.nav{position:fixed;top:0;left:0;width:100%;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:1rem var(--pad);background:transparent;transition:padding .4s var(--ease),box-shadow .4s,background .4s}
header.nav.scrolled{background:var(--green);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);box-shadow:0 6px 30px -14px rgba(0,0,0,.55);padding:.55rem var(--pad)}
.logo{display:flex;align-items:center;height:38px}
.logo img{height:36px;width:auto;transition:height .4s var(--ease)}
.logo img.flip{filter:brightness(0) invert(1)} /* fallback only: tints the green CDN logo white when the white SVG file isn't present */
header.nav.scrolled .logo img{height:30px}
.logo .logo-fallback{display:none;font-family:var(--display);font-weight:700;font-size:1.6rem;letter-spacing:.04em;color:var(--cream);text-transform:uppercase}
nav.links{display:flex;align-items:center;gap:1.7rem}
nav.links a{font-family:var(--display);text-transform:uppercase;font-weight:500;font-size:.95rem;letter-spacing:.05em;color:var(--cream);transition:color .2s}
nav.links a:hover{color:var(--marigold)}
nav.links .btn{font-size:.9rem;padding:.6rem 1.3rem}
.burger{display:none;flex-direction:column;gap:5px;background:none;border:0;cursor:pointer;padding:6px;z-index:120}
.burger span{width:26px;height:2.5px;background:var(--cream);border-radius:2px;transition:.3s}
#mtoggle{display:none}

/* ---------- Hero ---------- */
.hero{min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding:7rem var(--pad) 4rem;color:var(--cream);position:relative;overflow:hidden;background:linear-gradient(150deg,var(--green-deep),var(--green) 55%,#3f5950)}
.hero .herovid{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.hero .vidph{position:absolute;inset:0;z-index:1;background:linear-gradient(150deg,rgba(42,59,53,.86),rgba(56,78,70,.64) 55%,rgba(63,89,80,.58)),radial-gradient(120% 90% at 78% 12%,rgba(230,144,37,.22),transparent 55%),radial-gradient(90% 80% at 8% 92%,rgba(131,149,102,.22),transparent 60%)}
.hero .vidph::after{content:"";position:absolute;inset:0;opacity:.5;background-image:repeating-linear-gradient(115deg,rgba(255,255,255,.025) 0 2px,transparent 2px 7px)}
.vidlabel{position:absolute;bottom:1.2rem;right:1.2rem;z-index:3;font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(237,236,230,.55);border:1px dashed rgba(237,236,230,.4);padding:.4rem .7rem;border-radius:6px}
.hero-inner{position:relative;z-index:2;max-width:var(--maxw);margin:0 auto;width:100%}
.kicker{font-family:var(--display);text-transform:uppercase;letter-spacing:.3em;font-size:.84rem;color:var(--cream);margin-bottom:1.3rem;font-weight:700;display:flex;align-items:center;gap:.6rem}
.kicker .bi{width:1.1em;height:1.1em;color:var(--marigold)}
.hero h1{font-size:clamp(3.2rem,10vw,8rem);max-width:13ch;letter-spacing:-.01em}
.hero h1 .script{color:var(--marigold);font-size:.74em;display:inline-block;letter-spacing:0}
.hero p.sub{font-size:clamp(1.05rem,2vw,1.4rem);max-width:50ch;margin:1.8rem 0 2.4rem;color:var(--cream);opacity:.92;font-weight:300}
.hero .cta-row{display:flex;gap:1rem;flex-wrap:wrap}
.scrollcue{position:absolute;bottom:1.6rem;left:50%;transform:translateX(-50%);z-index:2;color:rgba(237,236,230,.7);font-size:.72rem;letter-spacing:.25em;text-transform:uppercase;text-align:center;font-family:var(--display);font-weight:500}
.scrollcue .dot{display:block;width:1px;height:34px;margin:.6rem auto 0;background:rgba(237,236,230,.6);animation:cue 2.2s var(--ease) infinite}
@keyframes cue{0%{transform:scaleY(0);transform-origin:top}40%{transform:scaleY(1);transform-origin:top}60%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}

/* ---------- Proof marquee ---------- */
.proof{background:var(--cream)}
.proof-grid{max-width:var(--maxw);margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);text-align:center;padding:3rem var(--pad)}
.proof-grid .stat{padding:1rem;border-right:1px solid rgba(56,78,70,.18)}
.proof-grid .stat:last-child{border-right:0}
.proof .num{font-family:var(--display);font-weight:700;font-size:clamp(2.6rem,5.5vw,3.8rem);color:var(--green);line-height:1}
.proof .lbl{font-size:.84rem;letter-spacing:.13em;text-transform:uppercase;color:var(--green);font-weight:500;margin-top:.5rem;font-family:var(--display)}

/* ---------- Generic section ---------- */
.wrap{max-width:var(--maxw);margin:0 auto;padding:clamp(4rem,9vw,7.5rem) var(--pad)}
.eyebrow{font-family:var(--display);text-transform:uppercase;letter-spacing:.26em;font-size:.82rem;font-weight:700;margin-bottom:1.1rem;display:flex;align-items:center;gap:.55rem;color:var(--green)}
.eyebrow .bi{width:1.05em;height:1.05em;color:var(--marigold);flex:none}
.sec-light{background:var(--paper);color:var(--ink)}
.sec-dark{background:var(--green);color:var(--cream)}
.sec-dark .eyebrow{color:var(--cream)}
.sec-cream{background:var(--cream);color:var(--ink)}
h2.big{font-size:clamp(2.3rem,6vw,4.4rem);max-width:18ch;margin-bottom:1.4rem;letter-spacing:-.005em}
.lead{font-size:clamp(1.1rem,1.7vw,1.32rem);max-width:56ch;font-weight:300}
.sec-dark .lead{color:var(--cream);opacity:.9}

/* Opportunity two-col */
.two{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2rem,5vw,5rem);align-items:center}
.imgph{position:relative;border-radius:var(--r);overflow:hidden}
.two .imgph{aspect-ratio:4/5;background:linear-gradient(135deg,var(--sage),var(--green))}
.imgph .tag{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);text-align:center;color:rgba(255,255,255,.85);font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;font-family:var(--display);border:1px dashed rgba(255,255,255,.55);padding:.5rem .8rem;border-radius:6px;white-space:nowrap;z-index:0}
.imgph .ph-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1}

/* Comfort pull-quote band */
.comfort{background:var(--green-deep);color:var(--cream);text-align:center}
.comfort .wrap{padding-top:clamp(3rem,6vw,5rem);padding-bottom:clamp(3rem,6vw,5rem)}
.comfort h2{font-size:clamp(2rem,6vw,4rem);letter-spacing:-.01em}
.comfort h2 .script{color:var(--marigold);text-transform:none}
.comfort p{font-family:var(--display);text-transform:uppercase;letter-spacing:.2em;font-size:.85rem;color:var(--cream);opacity:.7;margin-top:1.2rem}

/* Two paths */
.paths{display:grid;grid-template-columns:1fr 1fr;gap:1.6rem;margin-top:3rem}
.path{background:var(--paper);color:var(--ink);border-radius:var(--r);overflow:hidden;border:1px solid rgba(56,78,70,.12);transition:transform .4s var(--ease),box-shadow .4s}
.path:hover{transform:translateY(-6px);box-shadow:0 24px 50px -24px rgba(42,59,53,.5)}
.path .top{height:9px}
.path.fs .top{background:linear-gradient(90deg,var(--green),var(--sage))}
.path.gg .top{background:linear-gradient(90deg,var(--marigold),var(--salmon))}
.path .body{padding:2.2rem}
.path h3{font-size:1.9rem;color:var(--green)}
.path .where{font-family:var(--script);color:var(--green);font-size:1.35rem;margin:.2rem 0 1rem}
.path ul{list-style:none;margin:1.2rem 0 1.6rem}
.path li{padding:.55rem 0 .55rem 1.7rem;position:relative;border-bottom:1px solid rgba(56,78,70,.1);font-size:1.02rem}
.path li:last-child{border-bottom:0}
.path li::before{content:"";position:absolute;left:0;top:1.1rem;width:9px;height:9px;border-radius:50%;background:var(--marigold)}
.path .from{font-family:var(--display);font-size:1rem;text-transform:uppercase;letter-spacing:.06em;color:var(--green);font-weight:500}
.path .from b{color:var(--green);font-size:1.8rem;display:block;letter-spacing:0}

/* ---------- Numbers / investment ---------- */
.numbers{background:var(--green-deep);color:var(--cream)}
.auv-hero{position:relative;text-align:center;max-width:var(--maxw);margin:0 auto;padding:clamp(4rem,9vw,7rem) var(--pad) 2rem}
.auv-hero .auv-num{font-family:var(--display);font-weight:700;font-size:clamp(3.4rem,12vw,8.5rem);color:var(--marigold);line-height:.9;letter-spacing:-.01em}
.auv-hero .auv-cap{font-family:var(--display);font-size:1rem;letter-spacing:.13em;text-transform:uppercase;color:var(--cream);opacity:.85;margin-top:1rem;font-weight:500}
/* starburst price badge (brand element: starbursts emphasize figures) */
.starburst{position:absolute;top:2.4rem;right:max(var(--pad),8%);width:130px;height:130px;display:grid;place-items:center;transform:rotate(-12deg);color:var(--green-deep)}
.starburst svg{position:absolute;inset:0;width:100%;height:100%;color:var(--marigold)}
.starburst .txt{position:relative;font-family:var(--display);font-weight:700;text-transform:uppercase;text-align:center;line-height:1.05;font-size:.92rem;letter-spacing:.03em}
.starburst .txt b{font-size:1.5rem;display:block}
.invest-grid{max-width:var(--maxw);margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem;padding:1rem var(--pad) 1.5rem}
.icard{background:rgba(237,236,230,.06);border:1px solid rgba(237,236,230,.16);border-radius:var(--r);padding:2rem;text-align:center}
.icard .v{font-family:var(--display);font-weight:700;font-size:3rem;color:var(--cream);line-height:1}
.icard .k{font-family:var(--display);font-size:.84rem;letter-spacing:.13em;text-transform:uppercase;color:var(--cream);opacity:.85;margin-top:.6rem;font-weight:500}
.range{max-width:var(--maxw);margin:0 auto;text-align:center;padding:1rem var(--pad)}
.range .big-range{font-family:var(--display);font-weight:700;font-size:clamp(1.7rem,4vw,2.7rem);color:var(--marigold)}
.range p{color:var(--cream);opacity:.78;max-width:50ch;margin:.7rem auto 0;font-size:.97rem}
.disclaimer{max-width:var(--maxw);margin:0 auto;padding:1.4rem var(--pad) 4rem;font-size:.72rem;line-height:1.55;color:rgba(237,236,230,.5)}

/* ---------- Dual revenue ---------- */
.rev{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,4rem);align-items:center}
.rev .imgph{aspect-ratio:1;background:linear-gradient(135deg,var(--salmon),var(--marigold))}
.chips{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.6rem}
.chip{font-family:var(--display);text-transform:uppercase;letter-spacing:.05em;font-size:.84rem;font-weight:700;background:var(--cream);color:var(--green);padding:.5rem 1rem;border-radius:999px;border:1px solid rgba(56,78,70,.16)}
.dayparts{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(56,78,70,.14);border-radius:var(--r);overflow:hidden;margin-top:2.5rem}
.dp{background:var(--paper);padding:1.6rem;text-align:center}
.dp .t{font-family:var(--display);font-weight:700;font-size:1.3rem;color:var(--green);text-transform:uppercase}
.dp .d{font-size:.88rem;color:var(--green);opacity:.8;margin-top:.3rem}

/* ---------- Support ---------- */
.support-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:1.2rem;margin-top:3rem}
.scard{background:rgba(237,236,230,.06);border:1px solid rgba(237,236,230,.16);border-radius:var(--r);padding:1.7rem;transition:transform .4s var(--ease),background .3s}
.scard:hover{transform:translateY(-5px);background:rgba(237,236,230,.11)}
.scard .ic{width:44px;height:44px;border-radius:10px;background:var(--marigold);color:var(--green-deep);display:grid;place-items:center;margin-bottom:1rem;font-family:var(--display);font-weight:700;font-size:1.25rem}
.scard h4{font-size:1.25rem;color:var(--cream);margin-bottom:.5rem;text-transform:none;letter-spacing:0}
.scard p{font-size:.92rem;color:var(--cream);opacity:.82;font-weight:300}

/* ---------- Testimonials ---------- */
.quotes{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-top:3rem}
.q{background:var(--paper);border-radius:var(--r);padding:2rem;border-top:7px solid var(--marigold);display:flex;flex-direction:column;justify-content:space-between}
.q p{font-size:1.05rem;line-height:1.5;margin-bottom:1.4rem}
.q .stars{color:var(--marigold);letter-spacing:3px;margin-bottom:.6rem;font-size:1.1rem}
.q .who{font-family:var(--display);font-weight:700;text-transform:uppercase;color:var(--green);font-size:1.05rem;letter-spacing:.04em}
.q .role{font-size:.85rem;color:var(--green);opacity:.75;font-family:var(--display);text-transform:uppercase;letter-spacing:.06em}
.press{display:flex;flex-wrap:wrap;gap:1.2rem;justify-content:center;align-items:center;margin-top:3.5rem}
.press .p{height:54px;min-width:130px;border:1px dashed rgba(56,78,70,.3);border-radius:8px;display:grid;place-items:center;font-size:.66rem;letter-spacing:.13em;text-transform:uppercase;color:rgba(56,78,70,.55);font-family:var(--display);padding:0 1rem;text-align:center}

/* ---------- Steps ---------- */
.steps{counter-reset:step;margin-top:3rem;display:grid;gap:.9rem}
.step{display:grid;grid-template-columns:auto 1fr;gap:1.4rem;align-items:start;background:var(--paper);border-radius:var(--r);padding:1.5rem 1.8rem;border:1px solid rgba(56,78,70,.1);transition:transform .35s var(--ease)}
.step:hover{transform:translateX(6px)}
.step .n{counter-increment:step;font-family:var(--display);font-weight:700;font-size:2rem;color:var(--marigold);min-width:2.4rem;line-height:1}
.step .n::before{content:counter(step,decimal-leading-zero)}
.step h4{font-size:1.2rem;color:var(--green);text-transform:none;letter-spacing:0}
.step p{font-size:.94rem;color:var(--green);opacity:.82;margin-top:.2rem}

/* ---------- Final CTA ---------- */
.final{background:linear-gradient(150deg,var(--green),var(--green-deep));color:var(--cream);text-align:center}
.final h2{font-size:clamp(2.6rem,8vw,5.6rem);margin:0 auto 1rem;letter-spacing:-.01em}
.final .script{color:var(--marigold);display:block;font-size:.7em;text-transform:none}
.form{max-width:560px;margin:2.5rem auto 0;display:grid;gap:1rem;text-align:left}
.form .row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.form input,.form select{width:100%;padding:1rem 1.1rem;border-radius:10px;border:1px solid rgba(237,236,230,.3);background:rgba(237,236,230,.08);color:var(--cream);font-family:var(--body);font-size:1rem}
.form input::placeholder{color:rgba(237,236,230,.6)}
.form select{color:rgba(237,236,230,.7)}
.form input:focus,.form select:focus{outline:2px solid var(--marigold);outline-offset:1px}
.form .note{font-size:.8rem;color:rgba(237,236,230,.7);line-height:1.5}
.form .btn{justify-content:center;width:100%;margin-top:.4rem}
.form .consent{display:flex;gap:.6rem;align-items:flex-start;font-size:.82rem;color:rgba(237,236,230,.82);line-height:1.5;text-align:left}
.form .consent input{width:auto;flex:none;margin-top:.15rem;accent-color:var(--marigold)}
.form .hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
.form input.err,.form select.err{outline:2px solid var(--salmon);outline-offset:1px}
.form-msg{margin:.2rem 0 0;font-family:var(--display);text-transform:uppercase;letter-spacing:.05em;font-size:.85rem;min-height:1em}
.form-msg.ok{color:var(--marigold)}.form-msg.bad{color:var(--salmon)}
.form-success{background:rgba(237,236,230,.07);border:1px solid rgba(230,144,37,.5);border-radius:var(--r);padding:2.6rem 2rem;text-align:center;max-width:560px;margin:2.5rem auto 0}
.form-success h3{color:var(--marigold);font-size:1.9rem}
.form-success p{color:var(--cream);opacity:.9;margin-top:.6rem;font-weight:300}

/* ---------- Footer ---------- */
footer{background:var(--green-deep);color:rgba(237,236,230,.78);font-size:.88rem}
.foot-top{max-width:var(--maxw);margin:0 auto;padding:3.5rem var(--pad) 2rem;display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:2rem}
.foot-top img.flogo{height:74px;width:auto;margin-bottom:1rem}
.foot-top .flogo-fallback{display:none;font-family:var(--display);font-weight:700;font-size:1.8rem;color:var(--cream);text-transform:uppercase;margin-bottom:1rem}
.foot-top h5{font-family:var(--display);font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--cream);font-size:.95rem;margin-bottom:1rem}
.foot-top a{display:block;padding:.25rem 0;color:rgba(237,236,230,.78)}
.foot-top a:hover{color:var(--marigold)}
.foot-top .contact a{color:var(--marigold);display:inline}
.legal{max-width:var(--maxw);margin:0 auto;padding:1.5rem var(--pad) 3rem;font-size:.7rem;line-height:1.6;color:rgba(237,236,230,.45);border-top:1px solid rgba(237,236,230,.14)}

/* ---------- Reveal ---------- */
.reveal{opacity:0;transform:translateY(34px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.reveal.in{opacity:1;transform:none}
.reveal.d1{transition-delay:.08s}.reveal.d2{transition-delay:.16s}.reveal.d3{transition-delay:.24s}.reveal.d4{transition-delay:.32s}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}.scrollcue{display:none}}

/* ---------- Responsive ---------- */
@media(max-width:900px){
  .two,.rev{grid-template-columns:1fr}
  .paths,.invest-grid,.quotes{grid-template-columns:1fr}
  .support-grid{grid-template-columns:1fr 1fr}
  .proof-grid{grid-template-columns:1fr 1fr}
  .proof-grid .stat:nth-child(2){border-right:0}
  .proof-grid .stat{border-bottom:1px solid rgba(56,78,70,.16);padding:1.4rem}
