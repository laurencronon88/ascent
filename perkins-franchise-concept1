var mt=document.getElementById('mtoggle');
document.querySelectorAll('nav.links a').forEach(function(a){a.addEventListener('click',function(){mt.checked=false;});});

/* build starburst graphics (brand element) */
function burst(spikes,outer,inner){
  var p=[],step=Math.PI/spikes,rot=-Math.PI/2,i;
  for(i=0;i<spikes;i++){
    p.push((50+Math.cos(rot)*outer).toFixed(2)+','+(50+Math.sin(rot)*outer).toFixed(2));rot+=step;
    p.push((50+Math.cos(rot)*inner).toFixed(2)+','+(50+Math.sin(rot)*inner).toFixed(2));rot+=step;
  }
  return p.join(' ');
}
document.querySelectorAll('svg.sb').forEach(function(svg){
  var isBadge=svg.closest('.starburst');
  var poly=document.createElementNS('http://www.w3.org/2000/svg','polygon');
  poly.setAttribute('points',burst(isBadge?16:12,49,isBadge?37:30));
  poly.setAttribute('fill','currentColor');
  svg.appendChild(poly);
});

/* ---- lead form ----
   Point LEAD_ENDPOINT at your CRM, e.g.:
   HubSpot  https://api.hsforms.com/submissions/v3/integration/submit/{portalId}/{formGuid}
   Salesforce Web-to-Lead  https://webto.salesforce.com/servlet/servlet.WebToLead?encoding=UTF-8
   or any Zapier/Make webhook that forwards to your CRM.
   Left empty = demo mode (validates + shows success, no network call). */
var LEAD_ENDPOINT='';
var form=document.getElementById('leadForm');
if(form){
  var msg=document.getElementById('formMsg');
  form.addEventListener('submit',function(e){
    e.preventDefault();
    if(document.getElementById('company').value){return;} /* honeypot tripped */
    var ok=true;
    ['fname','lname','email','phone','capital','consent'].forEach(function(id){
      var el=document.getElementById(id);
      var bad=(el.type==='checkbox')?!el.checked:!el.value.trim();
      if(id==='email'&&el.value&&!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(el.value)){bad=true;}
      el.classList.toggle('err',bad); if(bad){ok=false;}
    });
    if(!ok){msg.textContent='Please complete the highlighted fields.';msg.className='form-msg bad';return;}
    var data={firstName:document.getElementById('fname').value,lastName:document.getElementById('lname').value,email:document.getElementById('email').value,phone:document.getElementById('phone').value,market:document.getElementById('market').value,liquidCapital:document.getElementById('capital').value,consent:true};
    var done=function(){form.hidden=true;var s=document.getElementById('leadSuccess');s.hidden=false;s.scrollIntoView({behavior:'smooth',block:'center'});};
    msg.textContent='Sending\u2026';msg.className='form-msg ok';
    if(!LEAD_ENDPOINT){setTimeout(done,500);return;}
    fetch(LEAD_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)})
      .then(function(r){if(!r.ok){throw 0;}done();})
